{
	"name": "mark-to-go",
	"version": "26.4.6",
	"description": "Export shareable Markdown with images hosted through PicList, Alibaba Cloud OSS or AWS S3 while preserving local notes.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"check:node-types": "node scripts/check-node-types.mjs",
		"test": "tsx --test tests/*.test.ts",
		"test:piclist": "tsx --test tests/integration/*.test.ts"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "^1.14.4",
		"tsx": "^4.23.15",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"mdast-util-from-markdown": "^2.1.0"
	}
}
